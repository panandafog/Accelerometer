    },
    "measurement.magnetic_field.description" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The total magnetic field, including Earth’s geomagnetic field and bias introduced by the device and its surroundings. It is measured in microteslas (μT)."
