    "measurement.acceleration.description" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The acceleration measured by the accelerometer in G (gravitational force). One G equals the force of Earth’s gravitational field (9.81 m/s²)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ускорение, измеренное акселерометром в G (единицах силы тяжести). Один G равен силе гравитационного поля Земли (9,81 м/с²)."
          }
        }
      }
    },
    "measurement.acceleration.name" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "acceleration"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ускорение"
          }
        }
      }
    },
    "measurement.acceleration.short_name" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accel"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ускор."
          }
        }
      }
    },
    "measurement.attitude.description" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The device’s orientation relative to a known frame of reference at a point in time."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ориентация устройства относительно известной системы координат в данный момент времени."
          }
        }
      }
    },
    "measurement.attitude.name" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "attitude"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ориентация"
          }
        }
      }
    },
    "measurement.attitude.short_name" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attitude"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ориент."
          }
        }
      }
    },
    "measurement.gravity.description" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The gravity acceleration vector expressed in the device’s reference frame. One G equals the force of Earth’s gravitational field (9.81 m/s²)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вектор ускорения свободного падения в системе координат устройства. Один G равен силе гравитационного поля Земли (9,81 м/с²)."
          }
        }
      }
    },
    "measurement.gravity.name" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "gravity"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "гравитация"
          }
        }
      }
    },
    "measurement.gravity.short_name" : {
